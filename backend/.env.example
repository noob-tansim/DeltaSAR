# Copy to .env for local runs. On Render, set these in the dashboard (render.yaml lists them). Never commit .env.

# Database. Empty = SQLite file (local). On Render: the Supabase "Session pooler" URI (IPv4), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Where the API finds its data (the Docker image sets this to /app/deploy_data)
DELTASAR_OUTPUTS=deploy_data

# Volunteer console token (long random string)
CONSOLE_TOKEN=change-me

# The web app's address(es), for CORS and links in emails
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
PUBLIC_BASE_URL=http://localhost:5173

# Timers (seconds). Team rule: approve within 15 min, retry after 20 min, twice. Shorter for a live demo.
APPROVAL_WINDOW_S=600
RETRY_AFTER_S=300
MAX_RETRIES=2

# Refresh NASA IMERG rain and FFWC river every 6 h (0 = only the CSV snapshots in data/)
LIVE_INPUTS=1

# Web Push (python -m jobs.make_vapid_keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.org

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Guided demo sandboxes
SANDBOX_TTL_H=12
SANDBOX_MAX_PER_HOUR=60

# Science pipeline only (local): Google Earth Engine project
EE_PROJECT=

# "Ask DeltaSAR" website assistant (optional). Free key: https://aistudio.google.com → Get API key.
# Empty = assistant off; the built-in FAQ still answers. The key never reaches the browser.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
